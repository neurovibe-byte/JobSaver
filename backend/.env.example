# Copy to backend/.env and fill in. Every value is optional; the defaults work for local use.

# JWT signing key. If empty, one is generated into data/secret.key on first start.
# SECRET_KEY=

# Comma separated origins allowed to call the API directly (the Vite dev proxy doesn't need this).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Telegram alerts ----------
# Set up in the UI: Settings -> Telegram. These are only used as initial values on first start.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=

# ---------- Detection ----------
# Helmet model (Hugging Face "owner/repo", "owner/repo:file.pt" or a local .pt path)
# PPE_MODEL=keremberke/yolov8m-hard-hat-detection
# Optional models, loaded only when switched on in Settings:
# VEST_MODEL=Hansung-Cho/yolov8-ppe-detection
# FIRE_MODEL=rabahdev/fire-smoke-yolov8n
# FIRE_CONFIDENCE=0.45
# HELMET_PERSON_CONFIDENCE=0.5   # only judge helmets on clearly visible people
# POSE_MODEL=yolov8n-pose.pt
# DEVICE=auto              # auto | cpu | mps (Apple GPU) | 0 (NVIDIA GPU)
# DETECT_FPS=3             # frames analysed per second, per camera
# PPE_CONFIDENCE=0.25
# POSE_CONFIDENCE=0.25
# MIN_CONSECUTIVE_HITS=3   # a violation must persist this many analysed frames
# EVENT_COOLDOWN_SECONDS=60
# PERSON_DOWN_SECONDS=4
